{
  "name": "@beyondtrust/workload-credentials-action",
  "version": "1.0.2",
  "private": true,
  "description": "Securely retrieve secrets from BeyondTrust Workload Credentials in your GitHub Actions workflows via OIDC",
  "scripts": {
    "build": "tsx ./build.ts",
    "format": "prettier --write \"**/*.{ts,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,yaml,yml}\"",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "all": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "github-actions",
    "beyondtrust",
    "secrets",
    "security",
    "devops",
    "continuous-integration",
    "utilities",
    "oidc"
  ],
  "author": "BeyondTrust Corporation",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/http-client": "^4.0.1",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "@babel/core": "7.29.7",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": {
        ".": "^3.15.2",
        "argparse": "^2.0.1"
      }
    }
  }
}
